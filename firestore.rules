rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection rules
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null && 
                    (request.auth.token.email == "thabisomaqhawengwenya@gmail.com" || 
                     request.auth.token.email == "thabisongwenya39@gmail.com");
    }

    // Visits collection rules
    match /visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && 
                                    (request.auth.token.email == "thabisomaqhawengwenya@gmail.com" || 
                                     request.auth.token.email == "thabisongwenya39@gmail.com");
    }

    // Messages / Contact form collection rules
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && 
                                    (request.auth.token.email == "thabisomaqhawengwenya@gmail.com" || 
                                     request.auth.token.email == "thabisongwenya39@gmail.com");
    }

    // Telemetry and user interaction events (e.g. CV downloads)
    match /events/{eventId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && 
                                    (request.auth.token.email == "thabisomaqhawengwenya@gmail.com" || 
                                     request.auth.token.email == "thabisongwenya39@gmail.com");
    }

    // Skills / Tech stack collection rules
    match /skills/{skillId} {
      allow read: if true;
      allow write: if request.auth != null && 
                    (request.auth.token.email == "thabisomaqhawengwenya@gmail.com" || 
                     request.auth.token.email == "thabisongwenya39@gmail.com");
    }

    // Testimonials / Reviews collection rules
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null && 
                    (request.auth.token.email == "thabisomaqhawengwenya@gmail.com" || 
                     request.auth.token.email == "thabisongwenya39@gmail.com");
    }
  }
}

